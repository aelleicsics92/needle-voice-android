name: Unpack Needle Voice source

on:
  workflow_dispatch:

permissions:
  contents: write

jobs:
  unpack:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Extract project
        run: |
          unzip -q NeedleVoice-CloudBuild.zip -d extracted
          test -f extracted/NeedleVoice/settings.gradle.kts

      - name: Publish source branch
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          mkdir publish
          cp -a extracted/NeedleVoice/. publish/
          cd publish
          git init -b source-unpacked
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add .
          git commit -m "Extract Needle Voice Android source"
          git remote add origin "https://x-access-token:${GH_TOKEN}@github.com/${GITHUB_REPOSITORY}.git"
          git push --force origin source-unpacked
